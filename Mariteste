            box-shadow: 0 5px 20px rgba(255, 215, 0, 0.25);
            animation: fadeInUp 1s ease-out 1s;
            animation-fill-mode: backwards;
        }

        .cta-button:hover {
            transform: translateY(-7px) scale(1.05); /* Efeito mais pronunciado */
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.4);
            background-color: #ffdf33; /* Cor mais clara no hover */
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }


        /* --- Seção Sobre --- */
        #sobre p {
            max-width: 800px;
            margin: 0 auto;
            text-align: justify;
        }
        
        /* --- Seção Tiragens (Cartões Interativos) --- */
        .tiragens-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 2.5rem; /* Aumentado */
        }

        .cartao-flip {
            background-color: transparent;
            width: 330px; /* Aumentado */
            height: 480px; /* Aumentado */
            perspective: 1200px; /* Aumentado */
            transition: transform 0.3s ease; /* Para efeito de flutuação */
        }
        .cartao-flip:hover {
            transform: translateY(-10px); /* Efeito de flutuação */
        }

        .cartao-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.9s cubic-bezier(0.68, -0.55, 0.27, 1.55); /* Efeito de flip mais elástico */
            transform-style: preserve-3d;
        }
        
        .cartao-flip:hover .cartao-inner {
            transform: rotateY(180deg);
        }

        .cartao-frente, .cartao-verso {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2.5rem; /* Aumentado */
            background-color: var(--cor-cartao);
            border-radius: 20px; /* Mais arredondado */
            box-shadow: var(--sombra-cartao);
            border: 1px solid var(--cor-ouro-transparente);
            transition: box-shadow 0.3s ease;
        }
        .cartao-flip:hover .cartao-frente,
        .cartao-flip:hover .cartao-verso {
            box-shadow: var(--sombra-cartao-hover);
        }

        .cartao-frente {
            background-image: url('https://i.imgur.com/8z2xqhA.png'); /* Imagem de fundo do verso da carta */
