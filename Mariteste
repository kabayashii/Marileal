    <style>
        /* Importação de Fontes do Google Fonts */
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap');
        @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css'); /* Para ícones */

        /* Variáveis de Cores e Estilos Globais */
        :root {
            --cor-fundo: #121212;
            --cor-texto: #e0e0e0;
            --cor-ouro: #FFD700;
            --cor-ouro-transparente: rgba(255, 215, 0, 0.1);
            --cor-cartao: #1f1f1f;
            --sombra-cartao: 0 10px 25px rgba(0, 0, 0, 0.5);
            --sombra-cartao-hover: 0 15px 35px rgba(255, 215, 0, 0.2);
            --font-titulo: 'Playfair Display', serif;
            --font-corpo: 'Montserrat', sans-serif;
        }

        /* Reset e Estilos de Base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-corpo);
            background-color: var(--cor-fundo);
            color: var(--cor-texto);
            line-height: 1.8;
            overflow-x: hidden; /* Prevenir scroll horizontal */
        }

        /* --- Animações --- */
        .animate-on-scroll {
            opacity: 0;
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }

        .animate-fade-in {
            transform: translateY(40px);
        }
        .animate-fade-in-up {
            transform: translateY(50px);
        }
        .animate-slide-in-left {
            transform: translateX(-50px);
        }
        .animate-slide-in-right {
            transform: translateX(50px);
        }
        .animate-zoom-in {
            transform: scale(0.9);
        }

        .animate-on-scroll.visible {
            opacity: 1;
            transform: translateY(0) translateX(0) scale(1);
        }
        
        /* Delay nas animações */
        .delay-1 { transition-delay: 0.1s; }
        .delay-2 { transition-delay: 0.2s; }
        .delay-3 { transition-delay: 0.3s; }
        .delay-4 { transition-delay: 0.4s; }


        /* --- Cabeçalho e Navegação --- */
        .header {
            background-color: rgba(18, 18, 18, 0.8); /* Mais transparente */
            backdrop-filter: blur(12px); /* Blur mais intenso */
            padding: 1rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--cor-ouro-transparente);
            transition: background-color 0.3s ease, padding 0.3s ease;
        }

        .header.scrolled {
            background-color: rgba(12, 12, 12, 0.9); /* Mais escuro ao rolar */
            padding: 0.8rem 5%;
        }

        .logo {
            font-family: var(--font-titulo);
            font-size: 1.6rem; /* Aumentado */
            color: var(--cor-ouro);
            font-weight: 700;
            transition: transform 0.3s ease;
        }
        .logo:hover {
            transform: scale(1.05); /* Efeito sutil no logo */
        }

        .nav a {
            color: var(--cor-texto);
            text-decoration: none;
            margin-left: 2.2rem; /* Aumentado */
            font-weight: 400;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav a::after { /* Sublinhado animado */
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background-color: var(--cor-ouro);
            transition: width 0.4s ease;
        }

        .nav a:hover {
            color: var(--cor-ouro);
        }
        .nav a:hover::after {
            width: 100%;
        }
        
        /* --- Seções --- */
        .secao {
            padding: 120px 10% 100px; /* Aumentado padding superior */
            border-bottom: 1px solid var(--cor-ouro-transparente);
            text-align: center;
            overflow: hidden; /* Para conter animações */
        }

        .secao-titulo {
            font-family: var(--font-titulo);
            font-size: 3rem; /* Aumentado */
            color: var(--cor-ouro);
            margin-bottom: 1.5rem; /* Aumentado */
        }

        .secao-subtitulo {
            font-size: 1.15rem; /* Aumentado */
            max-width: 750px; /* Aumentado */
            margin: 0 auto 3.5rem auto; /* Aumentado */
            color: #b0b0b0;
        }

        /* --- Seção Hero (Início) --- */
        #inicio {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(rgba(18, 18, 18, 0.75), var(--cor-fundo)), url('https://i.imgur.com/G2L9m24.jpeg') no-repeat center center/cover; /* Imagem de exemplo, substitua se necessário */
            position: relative; /* Para pseudo-elemento de overlay */
        }
        #inicio::before { /* Overlay sutil para mais contraste */
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0,0,0,0.1);
        }

        #inicio h1 {
            font-family: var(--font-titulo);
            font-size: 4.5rem; /* Aumentado */
            color: #fff;
            text-shadow: 0 0 25px rgba(0,0,0,0.8);
            animation: fadeInDown 1s ease-out; /* Animação de entrada */
        }

        #inicio p {
            font-size: 1.3rem; /* Aumentado */
            color: var(--cor-ouro);
            margin-top: 1.5rem; /* Aumentado */
            font-weight: 400;
            animation: fadeInUp 1s ease-out 0.5s; /* Animação com delay */
            animation-fill-mode: backwards; /* Garante que comece invisível */
        }

        .cta-button {
            background-color: var(--cor-ouro);
            color: var(--cor-fundo);
            padding: 18px 40px; /* Aumentado */
            text-decoration: none;
            font-weight: 600;
            border-radius: 50px;
            margin-top: 2.5rem; /* Aumentado */
